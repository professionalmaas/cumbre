{
  "family": "hub-cumbre-prd-migrate-005",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::110844251073:role/hub-cumbre-prd-ecs-execution",
  "containerDefinitions": [
    {
      "name": "migrate",
      "image": "110844251073.dkr.ecr.us-east-1.amazonaws.com/hub-cumbre-prd:migrate-005",
      "essential": true,
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:110844251073:secret:hub-cumbre-prd/secrets-wQNDw3:DATABASE_URL::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/hub-cumbre-prd",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "migrate-005"
        }
      }
    }
  ]
}
