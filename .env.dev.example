# Cumbre LOCAL-DEV harness — copy the relevant lines into web/.env.local (Next reads that).
# Everything here is gated behind DEV_MODE=1; with it unset the production AWS paths are
# 100% untouched. See dev/README.md for the full run path.

# --- Turn the harness ON ---
DEV_MODE=1

# --- Local Docker Postgres (docker-compose.dev.yml; host port 55432) ---
# DEV_MODE forces ssl:undefined for this URL (local pg speaks no TLS).
DATABASE_URL=postgres://cumbre:cumbre@localhost:55432/cumbre

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- A&R copy (OPTIONAL) ---
# With a key, the report's verdict/market-fit/comparables come from Claude Haiku.
# WITHOUT it, worker/cumbre_report.py uses a deterministic heuristic fallback — the
# full report still renders. This is the ONLY thing the owner may want to provide.
ANTHROPIC_API_KEY=

# --- Stripe (OPTIONAL in DEV_MODE — entitlement is auto-granted) ---
# Public hosted Payment Links (NOT secrets). When set, /plans redirects the browser to
# these with ?client_reference_id=<sub>&prefilled_email=<email>.
NEXT_PUBLIC_STRIPE_SUMMIT_URL=https://buy.stripe.com/bJe6oG5WL8GI7flbQJawo01
NEXT_PUBLIC_STRIPE_SEASON_URL=https://buy.stripe.com/fZufZgad13mo9nt081awo00
# To actually test payments locally, run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# and set these from your Stripe test dashboard + the CLI output:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Worker python (OPTIONAL) — override how the inline runner invokes Python ---
# Defaults to `python` on Windows, `python3` elsewhere. Point this at your venv if needed:
# DEV_PYTHON=C:/Users/you/Projects/cumbre/.venv/Scripts/python.exe
DEV_PYTHON=
