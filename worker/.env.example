# Cumbre worker — copy to worker/.env (gitignored) for local runs. Never commit real keys.
# In production these come from the worker's Secrets Manager secret (Terraform).

# Claude Haiku A&R layer. Without it, build_report uses a deterministic heuristic fallback.
ANTHROPIC_API_KEY=

# Lyrics transcription (Phase 2). Not needed for the Phase-1 report.
OPENAI_API_KEY=

# Only used on AWS (download audio from S3 + the fame-blind model). Not needed for run_local.py.
AWS_REGION=us-east-1
S3_UPLOAD_BUCKET=
CUMBRE_MODEL_S3=
