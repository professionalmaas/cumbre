# Cumbre web — copy to .env.local and fill in. These mirror the Terraform app_secrets +
# app_env_vars (infra/terraform/main.tf). In production they're injected from Secrets
# Manager by ECS; for local dev put them here. Never commit real values.

# =====================================================================================
# LOCAL-DEV HARNESS (DEV_MODE) — the no-AWS loop. See dev/README.md / docs/LOCAL_DEV.md.
# When DEV_MODE=1: dev-auth (no Cognito), local file storage (no S3), inline Python
# worker (no Step Functions), local Docker Postgres, auto-granted entitlement (no Stripe).
# For the local loop you only need the FOUR lines below (ANTHROPIC_API_KEY is optional).
# Leave DEV_MODE unset to use the production AWS paths (everything below this block).
# -------------------------------------------------------------------------------------
# DEV_MODE=1
# DATABASE_URL=postgres://cumbre:cumbre@localhost:55432/cumbre
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# ANTHROPIC_API_KEY=                 # OPTIONAL — heuristic fallback works without it
# Public Stripe Payment Links (not secrets) — used by /plans when set:
# NEXT_PUBLIC_STRIPE_SUMMIT_URL=https://buy.stripe.com/bJe6oG5WL8GI7flbQJawo01
# NEXT_PUBLIC_STRIPE_SEASON_URL=https://buy.stripe.com/fZufZgad13mo9nt081awo00
# To test payments locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# then set STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET (test mode).
# =====================================================================================

# --- Database (RDS Postgres) ---
DATABASE_URL=                       # postgres://user:pass@host:5432/cumbre

# --- Cognito (dedicated Cumbre user pool; self-signup) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=                     # hosted-UI domain prefix (e.g. certus-cumbre-prd)
COGNITO_ISSUER=                     # https://cognito-idp.<region>.amazonaws.com/<poolId>
AWS_REGION=us-east-1

# --- Session ---
SESSION_SECRET=                     # 32+ random chars (openssl rand -base64 32); signs the app cookie

# --- Stripe (pay-first: Summit one-time + Season subscription) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SUMMIT=                # one-time price id ($9 — one analysis)  [Checkout-Sessions fallback]
STRIPE_PRICE_SEASON=                # recurring price id ($19/mo — unlimited) [Checkout-Sessions fallback]
# Preferred: hosted Payment Links (public, not secrets). When set, /plans redirects here.
NEXT_PUBLIC_STRIPE_SUMMIT_URL=     # e.g. https://buy.stripe.com/...  (Summit $9 once)
NEXT_PUBLIC_STRIPE_SEASON_URL=     # e.g. https://buy.stripe.com/...  (Season $19/mo)

# --- AWS resources the app calls directly ---
S3_UPLOAD_BUCKET=                   # uploads bucket (presigned PUT/GET, delete-after-analyze)
ANALYZE_STATE_MACHINE_ARN=         # Step Functions analyze state machine ARN

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=                       # comma-separated emails allowed into /admin/review
KILL_SWITCH_SCORING=off             # 'on' halts the charge path (checked in the charge Lambda)
LOW_CONFIDENCE_THRESHOLD=0.7        # below this -> human review (worker maps confidence = overall/100)

# NOTE: the worker (worker/.env) needs ANTHROPIC_API_KEY (A&R copy), OPENAI_API_KEY,
# S3_UPLOAD_BUCKET, CUMBRE_MODEL_S3. The step Lambdas need DATABASE_URL, S3_UPLOAD_BUCKET, ACRCLOUD_*.
