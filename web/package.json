{
  "name": "cumbre-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dev:db": "docker compose -f ../docker-compose.dev.yml up -d",
    "dev:db:down": "docker compose -f ../docker-compose.dev.yml down",
    "dev:setup": "bash ../dev/init-db.sh",
    "dev:all": "npm run dev:db && npm run dev:setup && npm run dev"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.658.1",
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/client-sfn": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "jose": "^5.9.6",
    "next": "14.2.25",
    "recharts": "^2.13.0",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
