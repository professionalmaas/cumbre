# Cumbre — environment variables (copy to .env.local for web, .env for worker; never commit real values)

# --- Supabase (auth + db + storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; never expose to the browser

# --- Stripe (credits + payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_CREDITS_PACK=          # price id for a credit pack

# --- Inngest (durable workflow) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Modal (ML worker) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
CUMBRE_MODEL_URL=                   # object-storage URL of CUMBRE_fameblind_model.pkl

# --- OpenAI (lyric transcription + feedback + moderation) ---
OPENAI_API_KEY=

# --- ACRCloud (copyright fingerprint gate) ---
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
KILL_SWITCH_SCORING=off             # flip to "on" to halt the scoring+charge path in an incident
